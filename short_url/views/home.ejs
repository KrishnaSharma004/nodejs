<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomePage</title>
</head>
<body style="background-color: rgb(1, 21, 21); color: blanchedalmond;">
    <h1 align="center">URL Shortener</h1>
    <br>
    <br>
    <br>
    <% if (locals.id) { %>
    <p align = "center">Short URL Generated : http://localhost:8001/url/<%= id %></p>
    <% } %>
    <form method = "post", action = "/url", align="center">
        <label>Enter your original URL</label>
        <br>
        <br>
        <input type = "text", name = "url" , placeholder="https://exmp.com"
        />
        <button type = "submit">Generate</button>
    </form>
    <br>
    <br>
    <br>
    <br>
    <div>
        <% if (locals.urls) { %>
            <table align = "center">
            <head>
                <thead>
                    <th>Sr.NO:</th>
                    <th>ShortID</th>
                    <th>RedirectedURL</th>
                    <th>Clicks</th>
                </thead>
                <tbody>
                    <% urls.forEach((url, index) => { %>
                     <tr>
                        <td><%= index + 1 %></td>
                        <td><%= url.ShortID %></td>
                        <td><%= url.ReDirectedURL %></td>
                        <td><%= url.VisitHistory.length %></td>
                     </tr>
                    <% }) %>
                </tbody>
            </head>
        </table>
        <% } %>
    </div>
</body>
</html>